# Copy to .env and change the values marked change-me. Never commit .env.

# Django
OEE_SECRET_KEY=change-me-to-a-long-random-string
OEE_DEBUG=False
OEE_ALLOWED_HOSTS=localhost,127.0.0.1
# Extra origins allowed to send changes with the login cookie, comma separated
OEE_CSRF_TRUSTED_ORIGINS=
OEE_TIME_ZONE=Europe/Berlin

# Database (also creates the Postgres container's database and user)
OEE_DB_NAME=oee
OEE_DB_USER=oee
OEE_DB_PASSWORD=change-me

# Admin account created on first start (with DEMO=true it owns the demo organization)
OEE_SUPERUSER_USERNAME=admin
OEE_SUPERUSER_PASSWORD=change-me
OEE_SUPERUSER_EMAIL=

# Fill the database with demo lines, events and maintenance plans on start
DEMO=true

# Email for invitations and password reset (optional for a local try-out)
OEE_EMAIL_HOST=
OEE_EMAIL_HOST_USER=
OEE_EMAIL_HOST_PASSWORD=
OEE_APP_NAME=Portfolio OEE & CMMS
# Public URL of the web app; empty = the address the request came in on
OEE_APP_URL=

# Optional (defaults shown)
# Port of the web app on this computer
OEE_HTTP_PORT=80
OEE_ALLOW_SIGNUP=True
OEE_SESSION_DAYS=14
OEE_INVITATION_DAYS=7
OEE_MAX_UPLOAD_MB=5
OEE_HTTPS=False
OEE_HSTS_SECONDS=0
OEE_NUM_PROXIES=1
OEE_THROTTLE_LOGIN=20/min
OEE_THROTTLE_SIGNUP=10/hour
OEE_THROTTLE_PASSWORD_RESET=10/hour
