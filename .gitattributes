# Store and check out text files with LF line endings on every OS,
# so editors and scripts on Windows cannot introduce CRLF churn.
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.woff binary
*.woff2 binary
